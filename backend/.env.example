# Copy to backend/.env. Obtain both URLs for the SAME Neon development branch.
# Runtime role must have restricted grants; never use the owner in the API.
DATABASE_URL=postgresql://knighthacks_backend:YOUR_PASSWORD@YOUR_ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
DB_POOL_MAX_SIZE=5
