# Copy to backend/.env. Get every URL from the SAME Neon development branch.
# One login per program; never use the owner in the API.
# API login (simulator role). Only the FastAPI backend reads this.
DATABASE_URL=postgresql://simulator:YOUR_PASSWORD@YOUR_ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Owner login, direct (non-pooler) host. Only scripts/apply_schema.py reads this.
MIGRATION_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_ENDPOINT.us-east-2.aws.neon.tech/neondb?sslmode=require
# map_import login. Only scripts/load_static.py reads this.
MAP_IMPORT_DATABASE_URL=postgresql://map_import:YOUR_PASSWORD@YOUR_ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
DB_POOL_MAX_SIZE=5
